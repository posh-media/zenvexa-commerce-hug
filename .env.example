# =============================================================================
# ShopBeta environment configuration
# Copy to .env.local (development), Vercel Preview, or Vercel Production.
# Never commit real secrets. Never put secret keys in NEXT_PUBLIC_* vars.
# =============================================================================

# --- Public app URLs (set per environment) ---
# Development:  http://localhost:3000
# Preview:      https://<preview>.vercel.app
# Production:   https://shopbeta.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional currency override (defaults to NGN via app constants)
# NEXT_PUBLIC_CURRENCY=NGN

# --- Firebase web config (client-safe; restrict API key by HTTP referrer) ---
# Firebase Console → Project settings → Your apps (web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shop-day84j.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shop-day84j
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=shop-day84j.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only — payment verify, COD finalize, webhooks, admin bootstrap) ---
# Prefer one of:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Disable one-time Super Admin bootstrap after first use (npm run admin:bootstrap)
# ADMIN_BOOTSTRAP_DISABLED=true

# --- Paystack ---
# Public key is safe for the browser (Inline JS). Redirect checkout works with
# NEXT_PUBLIC_PAYSTACK_ENABLED=true even if the public key is unset.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_ENABLED=true
PAYSTACK_SECRET_KEY=
# Optional; defaults to PAYSTACK_SECRET_KEY if unset
PAYSTACK_WEBHOOK_SECRET=
# Cloud Function base (initialize + webhook). Used when Admin SDK is not configured locally.
PAYSTACK_FUNCTIONS_BASE_URL=https://us-central1-shop-day84j.cloudfunctions.net
NEXT_PUBLIC_PAYSTACK_FUNCTIONS_BASE_URL=https://us-central1-shop-day84j.cloudfunctions.net

# Make.com — notified after successful Paystack verify + Firestore update
# MAKE_WEBHOOK_URL=https://hook.us2.make.com/...

# Make.com — dedicated webhook for admin-triggered transactional emails
# (Admin Orders → Send Email). Fallback when Firestore
# settings.notifications.transactionalEmailWebhookUrl is unset.
# MAKE_TRANSACTIONAL_WEBHOOK_URL=https://hook.us2.make.com/...

# --- Payment feature flags ---
NEXT_PUBLIC_PAYSTACK_ENABLED=true
NEXT_PUBLIC_COD_ENABLED=true
NEXT_PUBLIC_FLUTTERWAVE_ENABLED=false
NEXT_PUBLIC_KORAPAY_ENABLED=true

# Squad by GTBank (admin settings override these defaults)
NEXT_PUBLIC_SQUAD_ENABLED=false
SQUAD_SANDBOX=true
SQUAD_TEST_SECRET_KEY=
SQUAD_LIVE_SECRET_KEY=

# Flutterwave (prepared — not fully wired)
# NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=

# KoraPay
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=pk_test_uTQWES4mDPuTVJY8hhQ5aiBASxL4Jwy73aSsgoar
KORAPAY_SECRET_KEY=

# --- Environment checklist ---
# [ ] Production NEXT_PUBLIC_SITE_URL / NEXT_PUBLIC_APP_URL point to live domain
# [ ] Paystack live keys used only in Production; test keys in Preview/Dev
# [ ] Firebase Auth authorized domains include production + Vercel preview hosts
# [ ] Storage + Firestore rules published from storage.rules / firestore.rules
# [ ] firestore.indexes.json deployed (`firebase deploy --only firestore:indexes`)
# [ ] Paystack webhook URL: https://<domain>/api/payments/paystack/webhook
# [ ] MAKE_WEBHOOK_URL configured for order automation
# [ ] PAYSTACK_SECRET_KEY set (never commit; use Vercel/env only)

# Monnify: server-only credentials; admin settings override these defaults.
NEXT_PUBLIC_MONNIFY_ENABLED=false
MONNIFY_SANDBOX=true
MONNIFY_TEST_API_KEY=
MONNIFY_TEST_SECRET_KEY=
MONNIFY_TEST_CONTRACT_CODE=
MONNIFY_LIVE_API_KEY=
MONNIFY_LIVE_SECRET_KEY=
MONNIFY_LIVE_CONTRACT_CODE=
