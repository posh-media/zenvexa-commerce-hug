# Loaded at deploy time for Firebase Functions v2 params (defineString).
# Copy to .env and fill in values. Never commit .env (gitignored).

MAKE_WEBHOOK_URL=
KORAPAY_SECRET_KEY=
PAYSTACK_SECRET_KEY=
SQUAD_TEST_SECRET_KEY=
SQUAD_LIVE_SECRET_KEY=
SQUAD_SANDBOX=true
BACHS_SANDBOX_API_KEY=
BACHS_LIVE_API_KEY=
BACHS_SANDBOX_WEBHOOK_SECRET=
BACHS_LIVE_WEBHOOK_SECRET=
BACHS_SANDBOX=true

# Trusted origins for versioned/store-attributed webhook forwarding. No client-provided URLs are used.
SHOPBETA_WEBHOOK_ORIGIN=https://www.shopbetaa.store
ZENVEXA_WEBHOOK_ORIGIN=https://www.zenvexacommerce.com
